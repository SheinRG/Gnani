# Copy to .env.local and fill in. All of these also need to be set in the
# Vercel project's environment variables for the deployed app.

# Gnani speech-to-text (https://api.vachana.ai/stt/v3)
GNANI_API_KEY=

# Neon Postgres connection string (postgresql://...@....neon.tech/...?sslmode=require)
DATABASE_URL=

# Vercel Blob read-write token (from the Blob store's settings; on Vercel
# itself this is injected automatically once the store is connected)
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway key for the summary step (AI SDK reads this name directly)
AI_GATEWAY_API_KEY=

# Shared secret protecting /api/cron/reap (any long random string; Vercel Cron
# sends it automatically when set in the project env)
CRON_SECRET=
